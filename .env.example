# LLM Backend Configuration
# Choose one: openai, openrouter, bedrock
LLM_BACKEND=openai

# Model name/ID (backend-specific)
LLM_MODEL=gpt-4o-mini

# ============================================================================
# OpenAI Configuration
# ============================================================================
# Get API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Recommended models:
# - gpt-4o: Best quality ($2.50/1M input tokens, $10/1M output)
# - gpt-4o-mini: Fast and cheap ($0.15/1M input, $0.60/1M output)
# - gpt-3.5-turbo: Legacy, cheapest ($0.50/1M input, $1.50/1M output)

# ============================================================================
# OpenRouter Configuration
# ============================================================================
# Get API key from: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# Recommended models for data generation:
# - anthropic/claude-3.5-sonnet: Best quality ($3/1M tokens)
# - meta-llama/llama-3.1-70b-instruct: Good quality, fast ($0.35/1M)
# - google/gemini-pro-1.5: Cheap, decent quality ($0.125/1M)
# - mistralai/mistral-large: Fast, good quality ($2/1M)

# See all models: https://openrouter.ai/models

# ============================================================================
# AWS Bedrock Configuration
# ============================================================================
# Requires AWS credentials configured via `aws configure` or IAM role
# AWS_REGION=us-east-1

# Recommended models:
# - eu.amazon.nova-pro-v1:0: Fast, cheap ($0.60/1M input, $2.40/1M output)
# - eu.amazon.nova-lite-v1:0: Ultra cheap ($0.12/1M input, $0.48/1M output)
# - anthropic.claude-sonnet-4-5-20250929-v1:0: Best quality ($3/1M input, $15/1M output)
# - meta.llama3-70b-instruct-v1:0: Good balance ($1.35/1M input, $4.05/1M output)

# Enable model access in AWS Console → Bedrock → Model access
# Required IAM permissions: bedrock:InvokeModel

# ============================================================================
# HuggingFace Hub (for uploading datasets/models)
# ============================================================================
# Get token from: https://huggingface.co/settings/tokens
# HUGGINGFACE_TOKEN=hf_...
